{
  "name": "@itti/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "indexes": "tsx --env-file-if-exists=../../.env src/scripts/sync-indexes.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed-content": "tsx --env-file-if-exists=../../.env src/scripts/seed-content.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "export-templates": "tsx src/scripts/export-content-templates.ts"
  },
  "dependencies": {
    "@itti/schemas": "workspace:*",
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "@itti/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
