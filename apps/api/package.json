    "create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.7.0",
    "@itti/auth": "workspace:*",
    "@itti/db": "workspace:*",
    "@itti/email": "workspace:*",
    "@itti/media": "workspace:*",
    "@itti/schemas": "workspace:*",
    "better-auth": "^1.3.0",
    "hono": "^4.9.0",
    "ics": "^3.8.0",
    "mongodb": "~7.7.0",
    "mongoose": "^9.0.0",
    "nodemailer": "^7.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@itti/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
