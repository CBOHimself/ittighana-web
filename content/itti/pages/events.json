                    "html": "<style>\n    .calendar-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-family: 'Merriweather', Georgia, serif;\n        color: #002147;\n    }\n    .calendar-table th, .calendar-table td {\n        border: 1px solid #002147;\n        padding: 10px;\n        text-align: left;\n        vertical-align: top;\n    }\n    .calendar-table th {\n        background-color: #002147;\n        color: #E6E6E6;\n    }\n    .calendar-table tr:nth-child(even) {\n        background-color: #E6E6E6;\n    }\n    .calendar-table tr:nth-child(odd) {\n        background-color: #ffffff;\n    }\n    .calendar-table tr:hover {\n        background-color: #3277AE;\n        color: #ffffff;\n    }\n</style>\n\n<table class=\"calendar-table\">\n    <thead>\n        <tr>\n            <th>Date</th>\n            <th>Event</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr><td>6 Jan 2026</td><td>Institute Reopening</td></tr>\n        <tr><td>7 Jan 2026</td><td>Public Holiday (Constitution Day)</td></tr>\n        <tr><td>9 Jan 2026</td><td>Holiday (Constitutional Day)</td></tr>\n        <tr><td>13–16 Jan 2026</td><td>Student Resumes B103</td></tr>\n        <tr><td>22 Jan 2026</td><td>Orientation: Airport Passenger Services & Operations B104, Tourism Diploma B53 & IATA Cabin Crew B03, Customer Care B02</td></tr>\n        <tr><td>5 Feb 2026</td><td>Orientation: AI Prompt Engineering, Interpersonal & Communication Skills, Professional Development, Ramp Services, Cargo Intro Training</td></tr>\n        <tr><td>9 Feb 2026</td><td>Lecture begins: AI Prompt Engineering, Interpersonal & Communication Skills, Professional Development, Ramp Services, Cargo Intro Training</td></tr>\n        <tr><td>10 Feb 2026</td><td>Lecture begins: Airport Passenger Services, International Travel & Tourism Diploma B53, IATA Cabin Crew B03, Customer Care B02</td></tr>\n        <tr><td>12 Feb 2026</td><td>Orientation: Airport Passenger Services & Operations B105, Tourism Diploma B54, IATA Cabin Crew B04, Customer Care B03</td></tr>\n        <tr><td>13 Feb 2026</td><td>New Class Registration Ongoing</td></tr>\n        <tr><td>16–20 Feb 2026</td><td>Lecture: Airport Passenger Services & Operations B105, Tourism Diploma B54, IATA Cabin Crew B04, Customer Care B03</td></tr>\n        <tr><td>25 Feb 2026</td><td>Final Exam: Airport Passenger Services & Operations B103</td></tr>\n        <tr><td>3 Mar 2026</td><td>Orientation: Airport Passenger Services & Operations B106, Tourism Diploma B55, IATA Cabin Crew B05, Customer Care B04</td></tr>\n        <tr><td>6 Mar 2026</td><td>Independence Holiday</td></tr>\n        <tr><td>9–13 Mar 2026</td><td>Personal Development Week B11</td></tr>\n        <tr><td>10 Mar 2026</td><td>Lecture: Airport Passenger Services & Operations B106, Tourism Diploma B55, IATA Cabin Crew B05, Customer Care B04</td></tr>\n        <tr><td>16 Mar 2026</td><td>New Class Registration Ongoing</td></tr>\n        <tr><td>18–19 Mar 2026</td><td>CCBC XXXIX</td></tr>\n        <tr><td>25 Mar 2026</td><td>Airport Trip</td></tr>\n        <tr><td>23–26 Mar 2026</td><td>Revision Week for All Batches</td></tr>\n        <tr><td>26 Mar 2026</td><td>Orientation: AI Prompt Engineering, Interpersonal & Communication Skills, Professional Development, Ramp Services, Cargo Intro Training</td></tr>\n        <tr><td>27 Mar 2026</td><td>Midsem Exam: All Batches APH B104–B106, FTT B53–B55, Cabin Crew B03–B05, HSP B02–B04</td></tr>\n        <tr><td>31 Mar 2026</td><td>Simulation: APH Pilot Class / Lecture: AI Prompt Engineering, Professional Development, Ramp Services, Cargo Intro Training</td></tr>\n        <tr><td>1–8 Apr 2026</td><td>Easter Break</td></tr>\n        <tr><td>2–7 Apr 2026</td><td>Admin Break (Easter)</td></tr>\n        <tr><td>8 Apr 2026</td><td>Admin Resumes</td></tr>\n        <tr><td>9 Apr 2026</td><td>Lecture: APH Pilot Class</td></tr>\n        <tr><td>14 Apr 2026</td><td>Pilot Class: Airport Passenger Services & Op