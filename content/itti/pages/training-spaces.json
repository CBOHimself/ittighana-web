        {
          "id": "16eb0e52",
          "type": "text-editor",
          "props": {
            "editor": "<p>The classroom can be booked on an <strong data-start=\"642\" data-end=\"658\">hourly basis</strong>.<br data-start=\"659\" data-end=\"662\">To make a reservation, simply <strong data-start=\"692\" data-end=\"715\">contact us directly</strong> or <strong data-start=\"719\" data-end=\"756\">complete the booking request form</strong> on this page. Our team will confirm availability and pricing once your request is received.<br>* Timeslots are subject to availability</p>"
          },
          "styles": [
            {
              "bp": "base",
              "sel": "",
              "css": {
                "padding": "19px 19px 19px 19px"
              }
            }
          ]
        },
        {
          "id": "d5d50ca",
          "type": "text-editor",
          "props": {
            "editor": "<h3 data-start=\"850\" data-end=\"885\">Classroom Features &amp; Facilities</h3><ul data-start=\"886\" data-end=\"1158\"><li data-start=\"886\" data-end=\"911\"><p data-start=\"888\" data-end=\"911\"><strong data-start=\"888\" data-end=\"911\">20-seater classroom</strong></p></li><li data-start=\"912\" data-end=\"951\"><p data-start=\"914\" data-end=\"951\"><strong data-start=\"914\" data-end=\"939\">Fully air-conditioned</strong> environment</p></li><li data-start=\"952\" data-end=\"986\"><p data-start=\"954\" data-end=\"986\"><strong data-start=\"954\" data-end=\"967\">Projector</strong> with clear display</p></li><li data-start=\"987\" data-end=\"1023\"><p data-start=\"989\" data-end=\"1023\"><strong data-start=\"989\" data-end=\"1023\">Bright, well-balanced lighting</strong></p></li><li data-start=\"1024\" data-end=\"1056\"><p data-start=\"1026\" data-end=\"1056\"><strong data-start=\"1026\" data-end=\"1046\">Individual desks</strong> available</p></li><li data-start=\"1057\" data-end=\"1116\"><p data-start=\"1059\" data-end=\"1116\"><strong data-start=\"1059\" data-end=\"1085\">Web conferencing setup</strong> for hybrid or virtual sessions</p></li><li data-start=\"1117\" data-end=\"1158\"><p data-start=\"1119\" data-end=\"1158\">Quiet, professional learning atmosphere</p></li></ul><h3 data-start=\"1160\" data-end=\"1176\">Suitable For</h3><ul data-start=\"1177\" data-end=\"1340\"><li data-start=\"1177\" data-end=\"1208\"><p data-start=\"1179\" data-end=\"1208\">Corporate training sessions</p></li><li data-start=\"1209\" data-end=\"1235\"><p data-start=\"1211\" data-end=\"1235\">Workshops and seminars</p></li><li data-start=\"1236\" data-end=\"1264\"><p data-start=\"1238\" data-end=\"1264\">Exam preparation classes</p></li><li data-start=\"1265\" data-end=\"1300\"><p data-start=\"1267\" data-end=\"1300\">Team meetings and presentations</p></li><li data-start=\"1301\" data-end=\"1340\"><p data-start=\"1303\" data-end=\"1340\">Virtual or hybrid learning sessions</p></li></ul>"
          },
          "styles": [
