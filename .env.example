# ─── Shared ─────────────────────────────────────────────
NODE_ENV=development

# MongoDB Atlas (database "itti" in prod, "itti_staging" on staging)
MONGODB_URI=mongodb+srv://itti_app:<password>@<cluster>.mongodb.net/itti?retryWrites=true&w=majority

# ─── API (apps/api) ────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Staff portal (served by the web app at /staff; in dev run the admin on :5176 and set ADMIN_DEV_URL on the web app)
ADMIN_PUBLIC_URL=http://localhost:3000/staff
# Cookie domain for shared admin/api session (prod: .ittighana.com, leave empty locally)
COOKIE_DOMAIN=

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-too

# Media storage (cPanel paths in prod)
MEDIA_PUBLIC_DIR=./storage/media
MEDIA_PRIVATE_DIR=./storage/private-uploads
MEDIA_PUBLIC_URL=http://localhost:4000/media

# SMTP (cPanel mail in prod)
SMTP_HOST=mail.ittighana.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@ittighana.com
SMTP_PASS=
MAIL_FROM="ITTI Ghana <no-reply@ittighana.com>"
ADMIN_NOTIFY_EMAIL=info@ittighana.com

# Cloudflare Turnstile (optional locally)
TURNSTILE_SECRET=

# ─── Web (apps/web) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Admin (apps/admin) ────────────────────────────────
VITE_API_URL=http://localhost:4000

# ── Staff portal security ──
# Roles allowed to sign in to /staff
PORTAL_ROLES=super_admin,admin
# Failed sign-ins per account (within 30 min) before a lock, and lock length
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Web app (dev only): proxy /staff to the admin Vite server
ADMIN_DEV_URL=http://localhost:5176
